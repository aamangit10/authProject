# DomainGuard — Supabase Environment Configuration
# Copy this file to .env and insert your project credentials from your Supabase Dashboard:
# (Project Settings -> API -> Project URL & Project API Keys 'anon' public key)

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Enforced Domain for Company SSO (default: hbplus.fit)
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit
